# ========================================
# CONFIGURACIÓN DEL SISTEMA DENTAL MATCHING
# ========================================

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=dental_matching
DB_PORT=3306

# Configuración de Google Sheets API
GOOGLE_SHEET_ID=tu_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu_service_account@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTu_Clave_Privada_Aquí\n-----END PRIVATE KEY-----\n"

# Configuración de Email (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password

# Configuración de Seguridad
SESSION_SECRET=tu_session_secret_muy_largo_y_complejo
JWT_SECRET=tu_jwt_secret_muy_largo_y_complejo
BCRYPT_ROUNDS=12

# Configuración de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuración de Logs
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Configuración de CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Configuración de Timeouts
REQUEST_TIMEOUT_MS=30000
DATABASE_TIMEOUT_MS=60000

# Configuración de Notificaciones
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=5000
