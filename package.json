{
  "name": "dental-matchg-system",
  "version": "0.1.0",
  "description": "Sistema de matching entre pacientes y estudiantes de odontología",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "pm2 start ecosystem.config.js --env production",
    "staging": "pm2 start ecosystem.config.js --env staging",
    "stop": "pm2 stop dental-matching",
    "restart": "pm2 restart dental-matching",
    "reload": "pm2 reload dental-matching",
    "logs": "pm2 logs dental-matching",
    "monitor": "pm2 monit",
    "install:prod": "npm install --production",
    "install:dev": "npm install",
    "setup": "bash install.sh",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "odontologia",
    "matching",
    "pacientes",
    "estudiantes"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.3",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
