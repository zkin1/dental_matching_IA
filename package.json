{
  "name": "dental-matching-system",
  "version": "2.0.0",
  "description": "Sistema empresarial de matching entre pacientes y estudiantes de odontología con arquitectura Clean",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js --watch src --watch routes --watch config\" \"wait-on http://localhost:3002/api/health && start http://localhost:3002\"",
    "dev:win": "start-dev.bat",
    "dev:unix": "./start-dev.sh",
    "dev:server-only": "nodemon server.js --watch src --watch routes --watch config",
    "prod": "pm2 start ecosystem.config.js --env production",
    "stop": "pm2 stop dental-matching",
    "restart": "pm2 restart dental-matching",
    "logs": "pm2 logs dental-matching",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/ routes/ config/ --ext .js",
    "lint:fix": "eslint src/ routes/ config/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"routes/**/*.js\" \"config/**/*.js\"",
    "migrate": "node scripts/migrate.js migrate",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:create": "node scripts/migrate.js create",
    "migrate:rollback": "node scripts/migrate.js rollback",
    "db:seed": "node scripts/seed.js",
    "db:reset": "npm run migrate:rollback && npm run migrate && npm run db:seed",
    "db:clean": "node scripts/clean-test-data.js",
    "db:create-admin": "node scripts/create-admin.js",
    "build": "npm run lint && npm run test",
    "validate": "npm run lint && npm run test:coverage",
    "precommit": "npm run lint:fix && npm run format",
    "prepare": "npm run build"
  },
  "keywords": [
    "odontologia",
    "matching",
    "pacientes",
    "estudiantes",
    "ai",
    "clean-architecture",
    "enterprise",
    "healthcare"
  ],
  "author": "Dental Matching Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "sanitize-html": "^2.17.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.6.3",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.2.4",
    "supertest": "^6.3.4",
    "wait-on": "^8.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dental-matching/dental-matching-system.git"
  },
  "bugs": {
    "url": "https://github.com/dental-matching/dental-matching-system/issues"
  },
  "homepage": "https://github.com/dental-matching/dental-matching-system#readme"
}
