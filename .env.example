# ===========================================
# Dental Matching System - Environment Config
# ===========================================
# Copiar a .env y ajustar valores

# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dental_matching
DB_CONNECTION_LIMIT=20
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Authentication
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_REFRESH_SECRET=cambiar-este-refresh-secreto-en-produccion
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Email (Gmail SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-app-password
ADMIN_EMAIL=admin@tudominio.com

# Frontend URL (para links en emails)
FRONTEND_URL=http://localhost:3000

# Redis (opcional, solo produccion)
# REDIS_ENABLED=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Logging
LOG_LEVEL=info
# LOG_DIR=./logs

# AI Agent (Ollama local or external OpenAI-compatible API)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# AI_AGENT_PORT=8001

# Server
# SERVER_TIMEOUT=30000
# JSON_LIMIT=10mb
